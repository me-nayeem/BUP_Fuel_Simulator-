SIMULATOR_BASE_URL=http://localhost:8000
SIMULATOR_TIMEOUT_MS=2500
SIMULATOR_MAX_RETRIES=2

SIMULATION_SPEED=8
TICK_MINUTES=15
SIMULATOR_START_MODE=paused

POSTGRES_USER=fuel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fuel_ops
