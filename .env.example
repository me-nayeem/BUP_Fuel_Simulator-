DATABASE_URL=postgresql://fuel:change-me@localhost:5432/fuel_ops

LOOP_POLL_MS=500
DEMAND_HISTORY_TICKS=32
AUTOPILOT_MODE=ASSISTED
ENABLE_SCENARIO_CONTROLS=true

OPENAI_API_KEY=
